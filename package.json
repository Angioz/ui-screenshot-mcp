{
  "name": "ui-screenshot-mcp",
  "version": "1.0.0",
  "description": "MCP server and CLI for UI research: search Refero, Mobbin, ScreensDesign and Dribbble, build a local screen library by category, and capture web page screenshots",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "screenshot": "node dist/cli.js",
    "test": "npm run build && node --test test/cli.test.mjs test/mcp.test.mjs test/library.test.mjs",
    "dev": "tsc && node dist/index.js",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "ui",
    "ux",
    "design",
    "screenshots",
    "inspiration",
    "refero",
    "mobbin",
    "dribbble",
    "playwright",
    "claude-code"
  ],
  "author": "Angioz (https://github.com/Angioz)",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "playwright": "^1.40.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "ui-screenshot-mcp": "dist/index.js",
    "ui-screenshot": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Angioz/ui-screenshot-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Angioz/ui-screenshot-mcp/issues"
  },
  "homepage": "https://github.com/Angioz/ui-screenshot-mcp#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
